# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# photo lab data
/photolab.db
/photolab.db-*
/public/uploads/*
!/public/uploads/.gitkeep

# исходники анимации и видео в корне
/*.mov

# локальная база (lib/db)
/data/*.db
/data/*.db-*
# кэш фото Unsplash (lib/unsplash.ts)
/data/unsplash-cache.json

!.env.example

# загруженные кадры (lib/storage)
/storage/

# стартовый набор кадров (scripts/import-photos.mjs): личные фото, в открытый репозиторий не кладём;
# без них база создаётся пустой (lib/db/seed.ts)
/seed/photos/

# устройство прода и деплой — не для открытого репозитория
CLAUDE.local.md
