# Скопируйте в .env.local и заполните. .env.local в git не попадает.

# Адрес сайта в браузере (с портом). Локально: http://localhost:3000.
# От него зависят адреса возврата: <APP_URL>/api/auth/google/callback и <APP_URL>/api/auth/yandex/callback
APP_URL=http://localhost:3000

# Ключи из Google Cloud Console (APIs & Services → Credentials → OAuth client ID, Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ключи приложения на oauth.yandex.ru (можно заполнить только Яндекс или только Google)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Почты владельцев через запятую (почта в Google или в Яндексе, как вы входите): при первом входе владелец получает
# архив, который уже лежит в базе (стартовые плёнки). Других прав у владельца нет: войти и вести свой архив может любой.
OWNER_EMAILS=

# Ключ Unsplash (unsplash.com/developers) — только для npm run editorial, обновления подборки фото заставки.
# Сайту он не нужен: фото лежат в public/editorial.
UNSPLASH_ACCESS_KEY=

# Служебное (нужно на сервере; локально можно не трогать)
# PLENKA_SEED=0            не класть в пустую базу стартовый набор плёнок
# PLENKA_DB_PATH=...       где лежит файл базы (по умолчанию data/plenka.db)
# PLENKA_STORAGE_DIR=...   где лежат загруженные кадры (по умолчанию storage/)
# MAX_FILE_MB=40           самый большой файл
# USER_QUOTA_GB=10         место на одного пользователя
# PHOTO_JOBS=1             сколько кадров сервер обрабатывает одновременно (на проде 1 CPU и 700 МБ у службы)
