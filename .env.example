# Скопируйте в .env.local и заполните. .env.local в git не попадает.

# Адрес сайта в браузере (с портом). Локально: http://localhost:3000.
# От него зависят адреса возврата: <APP_URL>/api/auth/google/callback и <APP_URL>/api/auth/yandex/callback
APP_URL=http://localhost:3000

# Ключи из Google Cloud Console (APIs & Services → Credentials → OAuth client ID, Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ключи приложения на oauth.yandex.ru (можно заполнить только Яндекс или только Google)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Почты владельцев через запятую (почта в Google или в Яндексе, как вы входите): только они могут загружать, править и удалять.
# Пусто: сайт открыт только для просмотра.
OWNER_EMAILS=

# Служебное (нужно на сервере; локально можно не трогать)
# PLENKA_SEED=0            не класть в пустую базу стартовые плёнки из прототипа
# PLENKA_DB_PATH=...       где лежит файл базы (по умолчанию data/plenka.db)
# PLENKA_STORAGE_DIR=...   где лежат загруженные кадры (по умолчанию storage/)
# MAX_FILE_MB=40           самый большой файл
# USER_QUOTA_GB=10         место на одного пользователя
